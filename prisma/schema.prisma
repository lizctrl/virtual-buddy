generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  last_name String
  state     Boolean
  phone     String
  password  String

  businesses   Business[]
  appointments Appointment[]
  moderations  Moderation[]
  profiles     Profile[]

  @@map("users")
}

model Catalog {
  id         Int    @id @default(autoincrement())
  name       String
  businessId Int
  state      Boolean @default(true)

  services Service[]

  business Business @relation(fields: [businessId], references: [id])

  @@map("catalog")
}

model Service {
  id        Int    @id @default(autoincrement())
  name      String
  catalogId Int
  state     Boolean @default(true)

  appointments Appointment[]
  availability Availability[]
  workingHours WorkingHours[]

  catalog Catalog @relation(fields: [catalogId], references: [id])

  @@map("services")
}

model Business {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  ownerId     Int?
  state       Boolean @default(true)

  owner User? @relation(fields: [ownerId], references: [id])

  catalogs    Catalog[]
  inventories Inventory[]
  moderations Moderation[]


  @@map("businesses")
}

model Appointment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  serviceId Int
  status    String
  dueDate   DateTime
  state     Boolean @default(true)

  notifications Notification[]

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("appointments")
}

model Availability {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    String
  serviceId Int
  state     Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id])

  @@map("availability")
}

model Inventory {
  id         Int      @id @default(autoincrement())
  createTime DateTime @default(now())
  businessId Int
  state      Boolean @default(true)
  items      Item[]

  business Business @relation(fields: [businessId], references: [id])

  @@map("inventories")
}

model Item {
  id          Int      @id @default(autoincrement())
  createTime  DateTime @default(now())
  name        String
  description String
  cost        Int
  quantity    Int
  inventoryId Int
  state       Boolean @default(true)

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("items")
}

model Moderation {
  id         Int      @id @default(autoincrement())
  createTime DateTime @default(now())
  userId     Int
  businessId Int
  status     String
  state      Boolean @default(true)

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@map("moderations")
}

model Notification {
  id            Int      @id @default(autoincrement())
  createTime    DateTime @default(now())
  title         String
  content       String
  appointmentId Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("notifications")
}

model Profile {
  id         Int      @id @default(autoincrement())
  createTime DateTime @default(now())
  picture    String
  userId     Int
  state      Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model WorkingHours {
  id        Int      @id @default(autoincrement())
  weekDay   String
  startTime DateTime
  endTime   DateTime
  serviceId Int
  state     Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id])

  @@map("working_hours")
}
